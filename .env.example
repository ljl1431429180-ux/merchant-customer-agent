# 配置参考：本项目在 Cloudflare/Vite 运行时读取同名变量。
# 本地调试请复制 .dev.vars.example 为 .dev.vars，再填入自己的值。
# 不要把真实密钥提交到 GitHub。

# 阿里云百炼（Qwen OpenAI-compatible API）密钥；未配置时，模型草稿能力会关闭。
DASHSCOPE_API_KEY=replace-with-your-own-key

# 可选：使用兼容 OpenAI 的自定义网关时再填写。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 商品同步示例脚本读取的后台地址。
DASHBOARD_URL=https://your-dashboard.example.com

# 本地 D1 模拟数据库的绑定名称，一般保持 DB。
D1_BINDING=DB
